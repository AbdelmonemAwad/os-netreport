#!/bin/sh

# core updates replace the GUI translation catalogs; add the Network Report strings back
ADDED=$(/usr/local/opnsense/scripts/netreport/merge_ui_translations.py 2> /dev/null)
if [ -n "${ADDED}" ] && [ "${ADDED}" != "0" ]; then
	# running php processes keep the old catalog in memory
	configctl webgui restart > /dev/null 2>&1
fi
